---
// BaseLayout — shared shell for all pages
// Props:
//   title: string
//   description: string
//   canonicalURL?: string (override default canonical)
//   ogImage?: string
//   schema?: any (JSON-LD schema object or array to inject)
import { config } from '../lib/config';
import '../styles/global.css';

const { title, description, canonicalURL, ogImage, schema } = Astro.props;
const fullTitle = title ? `${title} | ${config.siteName}` : config.siteName;
const canonical = canonicalURL || Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <title>{fullTitle}</title>
  <meta name="description" content={description || config.tagline} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description || config.tagline} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={config.siteName} />
  {ogImage ? (
    <meta property="og:image" content={ogImage} />
  ) : (
    <meta property="og:image" content="https://gearcompared.com/og-default.png" />
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description || config.tagline} />
  {ogImage ? (
    <meta name="twitter:image" content={ogImage} />
  ) : (
    <meta name="twitter:image" content="https://gearcompared.com/og-default.png" />
  )}

  <!-- JSON-LD Schema -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
  )}
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-logo">{config.siteName} <span>&rarr;</span></a>
      <nav>
        <ul class="site-nav">
          {config.categories.map((cat) => (
            <li><a href={`/${cat.slug}/`}>{cat.name}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__links">
        <a href="/methodology/">How we test</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
        <a href="/disclosure/">How we make money</a>
        <a href="/terms/">Terms</a>
      </div>
      <p>&copy; {new Date().getFullYear()} {config.siteName}. As an Amazon Associate we earn from qualifying purchases &mdash; this does not affect which products we recommend or how we rank them.</p>
    </div>
  </footer>
</body>
</html>
