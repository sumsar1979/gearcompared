---
// ComparisonLayout — "Best X: Year Comparison" multi-product comparison pages
import BaseLayout from './BaseLayout.astro';
import { generateComparisonLD, generateBreadcrumbLD, mergeLD } from '../lib/structured-data';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  winner,
  winnerReason,
  pageUrl,
  relatedGuides = [],
} = Astro.props;

const winnerProduct = products.find(p => p.asin === winner);
const allSpecs = new Set();
products.forEach(p => { if (p.specs) Object.keys(p.specs).forEach(k => allSpecs.add(k)); });
const specKeys = [...allSpecs];

// Schema
const breadcrumbLD = breadcrumbs.length ? generateBreadcrumbLD(breadcrumbs) : null;
const comparisonLD = generateComparisonLD(products, title, pageUrl);
const schema = breadcrumbLD ? mergeLD(breadcrumbLD, comparisonLD) : comparisonLD;
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <header class="article-header">
        <div class="changelog">{category?.replace(/-/g, ' ') || 'Comparison'} &middot; Updated {new Date().toISOString().split('T')[0]}</div>
        <h1>{title}</h1>
        {description && <p class="article-desc">{description}</p>}
      </header>

      <p class="disclosure-inline">
        We earn commissions from purchases made through links in this post at no extra cost to you.
        <a href="/disclosure/">Here&rsquo;s how we choose</a>.
      </p>

      {/* Winner Box — prominent above fold */}
      {winner && winnerProduct && (
        <div class="winner-box">
          <div class="winner-box__badge">Best Overall</div>
          <div class="winner-box__product">{winnerProduct.brand} {winnerProduct.title}</div>
          <div class="winner-box__price">
            ${winnerProduct.price || '?'}
            {winnerProduct.listPrice && <span class="list-price">${winnerProduct.listPrice}</span>}
          </div>
          <div class="winner-box__rating">
            {winnerProduct.rating} &starf; — {(winnerProduct.reviewCount || 0).toLocaleString()}+ reviews
          </div>
          {winnerReason && <div class="winner-box__reason">{winnerReason}</div>}
          <a href={winnerProduct.affiliateUrl} class="btn btn-buy winner-box__cta" rel="nofollow sponsored" target="_blank">
            Check Price on Amazon &rarr;
          </a>
          <div class="winner-box__disclosure">As an Amazon Associate we earn from qualifying purchases.</div>
        </div>
      )}

      <section>
        <h2 style="font-size:1.3rem;margin-bottom:16px;">Every spec, side by side</h2>
        <div style="overflow-x:auto;">
          <table class="specs-table">
            <thead>
              <tr>
                <th>Spec</th>
                {products.map(p => <th>{p.brand}</th>)}
              </tr>
            </thead>
            <tbody>
              {specKeys.map(key => (
                <tr>
                  <td class="row-label">{key}</td>
                  {products.map(p => <td>{p.specs?.[key] || '—'}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2>All products compared</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">
          {products.map(p => (
            <div class="product-card">
              {p.imageUrl && (
                <a href={p.affiliateUrl} rel="nofollow sponsored" target="_blank" class="product-card__image-link">
                  <img src={p.imageUrl} alt={p.title} class="product-card__image" loading="lazy" width="300" height="300" />
                </a>
              )}
              <div class="product-card__title">{p.title}</div>
              <div class="product-card__brand">{p.brand}</div>
              <div class="product-card__price">
                ${p.price || '?'}
                {p.listPrice && <span class="list-price">${p.listPrice}</span>}
              </div>
              {p.rating && (
                <div class="product-card__rating">
                  <span class="product-card__stars">{p.rating} &starf;</span>
                  <span class="product-card__review-count">{(p.reviewCount || 0).toLocaleString()}+ ratings</span>
                  <a href={(() => { if (p.affiliateUrl && p.affiliateUrl.includes('/dp/')) return `https://www.amazon.com/dp/${p.asin}#customerReviews?tag=gearcompared2-20`; return `https://www.amazon.com/s?k=${encodeURIComponent(p.title)}#customerReviews&tag=gearcompared2-20`; })()} class="product-card__review-link" rel="nofollow sponsored" target="_blank">
                    See reviews on Amazon &rarr;
                  </a>
                </div>
              )}
              {p.features && (
                <ul class="feature-list">
                  {p.features.slice(0, 3).map(f => <li>{f}</li>)}
                </ul>
              )}
              <a href={p.affiliateUrl} class="product-card__cta" rel="nofollow sponsored" target="_blank">
                View on Amazon &rarr;
              </a>
              <div style="font-size:0.75rem;color:var(--text-tertiary);margin-top:6px;">As an Amazon Associate we earn from qualifying purchases.</div>
            </div>
          ))}
        </div>
      </section>
      {relatedGuides.length > 0 && (
        <section class="related">
          <h2>Further reading</h2>
          <div class="related-list">
            {relatedGuides.map((g) => (
              <a href={`/${g.slug}/`}>
                {g.title} &rarr;
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
