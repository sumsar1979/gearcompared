---
// ComparisonLayout — "X vs Y" head-to-head comparison pages
import BaseLayout from './BaseLayout.astro';

const {
  title,
  description,
  category,
  productA = {},
  productB = {},
  verdict = {},
  specComparison = [],
  detailSections = [],
  breadcrumbs = [],
  relatedPages = [],
} = Astro.props;

const url = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <header class="article-header">
        <div class="changelog">{category || 'Comparison'} · Updated {new Date().toISOString().split('T')[0]}</div>
        <h1>{title}</h1>
        {description && <p style="font-size:1.05rem;color:var(--text-secondary);line-height:1.6;margin-bottom:24px;">{description}</p>}
      </header>

      <p class="disclosure-inline">
        When you buy through our links, we may earn a commission.
        <a href="/disclosure/">Here's how we choose</a>.
      </p>

      <div class="verdict-box">
        <div class="verdict-box__label">The short answer</div>
        <div class="verdict-box__answer">{verdict.summary}</div>
        {verdict.body && <div class="verdict-box__body">{verdict.body}</div>}
      </div>

      <div class="vs-grid">
        <div class="vs-card">
          <div class="vs-card__name">{productA.name}</div>
          <div class="vs-card__brand">{productA.brand}</div>
          <div class="vs-card__price">${productA.price || '?'}</div>
          <div style="font-size:0.85rem;color:var(--text-tertiary)">{productA.rating} ★ · {productA.reviewCount?.toLocaleString()}+ reviews</div>
        </div>
        <div class="vs-separator">vs</div>
        <div class="vs-card">
          <div class="vs-card__name">{productB.name}</div>
          <div class="vs-card__brand">{productB.brand}</div>
          <div class="vs-card__price">${productB.price || '?'}</div>
          <div style="font-size:0.85rem;color:var(--text-tertiary)">{productB.rating} ★ · {productB.reviewCount?.toLocaleString()}+ reviews</div>
        </div>
      </div>

      <section>
        <h2 style="font-size:1.3rem;margin-bottom:16px;">Every spec, side by side</h2>
        <table class="specs-table">
          <thead>
            <tr><th>Spec</th><th>{productA.name}</th><th>{productB.name}</th><th>Winner</th></tr>
          </thead>
          <tbody>
            {specComparison.map((row) => (
              <tr>
                <td class="row-label">{row.label}</td>
                <td class={row.winner === 'a' ? 'winner' : ''}>{row.valueA}</td>
                <td class={row.winner === 'b' ? 'winner' : ''}>{row.valueB}</td>
                <td class={row.winner && row.winner !== 'tie' ? 'winner' : ''}>
                  {row.winner === 'a' ? productA.name : row.winner === 'b' ? productB.name : 'Tie'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      {detailSections.map((section) => (
        <section class="guide-section">
          <h3>{section.title}</h3>
          <p>{section.body}</p>
        </section>
      ))}

      {relatedPages.length > 0 && (
        <section class="related">
          <h2>More comparisons</h2>
          <div class="related-list">
            {relatedPages.map((p) => (
              <a href={p.url}>{p.title} &rarr;</a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
