---
// ComparisonLayout — "Best X: Year Comparison" multi-product comparison pages
import BaseLayout from './BaseLayout.astro';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  winner,
  winnerReason,
} = Astro.props;

const winnerProduct = products.find(p => p.asin === winner);
const allSpecs = new Set();
products.forEach(p => { if (p.specs) Object.keys(p.specs).forEach(k => allSpecs.add(k)); });
const specKeys = [...allSpecs];
---

<BaseLayout title={title} description={description}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <header class="article-header">
        <div class="changelog">{category?.replace(/-/g, ' ') || 'Comparison'} &middot; Updated {new Date().toISOString().split('T')[0]}</div>
        <h1>{title}</h1>
        {description && <p class="article-desc">{description}</p>}
      </header>

      <p class="disclosure-inline">
        When you buy through our links, we may earn a commission.
        <a href="/disclosure/">Here&rsquo;s how we choose</a>.
      </p>

      {winner && winnerProduct && (
        <div class="verdict-box">
          <div class="verdict-box__label">The short answer</div>
          <div class="verdict-box__answer">{winnerProduct.title}</div>
          {winnerReason && <div class="verdict-box__body">{winnerReason}</div>}
        </div>
      )}

      <section>
        <h2 style="font-size:1.3rem;margin-bottom:16px;">Every spec, side by side</h2>
        <div style="overflow-x:auto;">
          <table class="specs-table">
            <thead>
              <tr>
                <th>Spec</th>
                {products.map(p => <th>{p.brand}</th>)}
              </tr>
            </thead>
            <tbody>
              {specKeys.map(key => (
                <tr>
                  <td class="row-label">{key}</td>
                  {products.map(p => <td>{p.specs?.[key] || '—'}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2>Price comparison</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">
          {products.map(p => (
            <div class="product-card">
              {p.imageUrl && (
                <a href={p.affiliateUrl} rel="nofollow sponsored" target="_blank" class="product-card__image-link">
                  <img src={p.imageUrl} alt={p.title} class="product-card__image" loading="lazy" width="300" height="300" />
                </a>
              )}
              <div class="product-card__title">{p.title}</div>
              <div class="product-card__brand">{p.brand}</div>
              <div class="product-card__price">
                ${p.price || '?'}
                {p.listPrice && <span class="list-price">${p.listPrice}</span>}
              </div>
              <div style="font-size:0.85rem;color:var(--text-tertiary);margin-bottom:12px;">
                {p.rating} &starf; &middot; {(p.reviewCount || 0).toLocaleString()}+ reviews
              </div>
              {p.features && (
                <ul class="feature-list">
                  {p.features.slice(0, 3).map(f => <li>{f}</li>)}
                </ul>
              )}
              <a href={p.affiliateUrl} class="product-card__cta" rel="nofollow sponsored" target="_blank">
                View on Amazon &rarr;
              </a>
              <div style="font-size:0.75rem;color:var(--text-tertiary);margin-top:6px;">As an Amazon Associate we earn from qualifying purchases.</div>
            </div>
          ))}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
