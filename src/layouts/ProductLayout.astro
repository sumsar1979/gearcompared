---
// ProductLayout — Single product review page
import BaseLayout from './BaseLayout.astro';
import { generateProductLD, generateBreadcrumbLD, mergeLD } from '../lib/structured-data';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  body,
  relatedProducts = [],
  relatedGuides = [],
} = Astro.props;

const product = products[0] || {};

// Generate schema
const reviewDate = product.lastUpdated || new Date().toISOString();
const breadcrumbLD = breadcrumbs.length ? generateBreadcrumbLD(breadcrumbs) : null;
const productLD = product.asin ? generateProductLD(product) : null;
const schemaComponents = [breadcrumbLD, productLD].filter(Boolean);
const schema = schemaComponents.length === 1 ? schemaComponents[0] : mergeLD(...schemaComponents);
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <header class="article-header">
        <h1>{product.title || title}</h1>
        <div style="font-size:1rem;color:var(--text-tertiary);margin-bottom:12px;">{product.brand}</div>
        <p class="article-desc">{description}</p>
      </header>

      <p class="disclosure-inline">
        We earn commissions from purchases made through links in this post at no extra cost to you.
        <a href="/disclosure/">Here&rsquo;s how we choose</a>.
      </p>

      <div class="product-card">
        {product.imageUrl && (
          <img src={product.imageUrl} alt={product.title} class="product-card__image product-card__image--hero" loading="eager" width="500" height="500" />
        )}
        <div class="product-card__price">
          ${product.price || '?'}
          {product.listPrice && <span class="list-price">${product.listPrice}</span>}
        </div>
        {product.specs && typeof product.specs === 'object' && (
          <table class="specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr><td class="row-label">{key}</td><td>{value}</td></tr>
              ))}
            </tbody>
          </table>
        )}
        {product.rating && (
          <div class="product-card__rating">
            <span class="product-card__stars">{product.rating} &starf;</span>
            <span class="product-card__review-count">{(product.reviewCount || 0).toLocaleString()}+ ratings</span>
            <a href={(() => { if (product.affiliateUrl && product.affiliateUrl.includes('/dp/')) return `https://www.amazon.com/dp/${product.asin}#customerReviews?tag=gearcompared2-20`; return `https://www.amazon.com/s?k=${encodeURIComponent(product.title)}#customerReviews&tag=gearcompared2-20`; })()} class="product-card__review-link" rel="nofollow sponsored" target="_blank">
              See reviews on Amazon &rarr;
            </a>
            <div class="product-card__review-disclaimer">
              Ratings independently verified. Last checked: {product.lastUpdated ? new Date(product.lastUpdated).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) : 'recently'}.
            </div>
          </div>
        )}
        <a href={product.affiliateUrl} class="product-card__cta" rel="nofollow sponsored" target="_blank">
          Check Price on Amazon &rarr;
        </a>
        <div style="font-size:0.8rem;color:var(--text-tertiary);margin-top:8px;">
          As an Amazon Associate we earn from qualifying purchases.
        </div>
      </div>

      {/* Pros & Cons */}
      {(product.pros || product.cons) && (
        <div class="pros-cons">
          {product.pros && product.pros.length > 0 && (
            <div class="pros-cons__col">
              <h3 class="pros-cons__heading pros-cons__heading--pros">What We Like</h3>
              <ul class="pros-cons__list">
                {product.pros.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          )}
          {product.cons && product.cons.length > 0 && (
            <div class="pros-cons__col">
              <h3 class="pros-cons__heading pros-cons__heading--cons">What We Don&rsquo;t Like</h3>
              <ul class="pros-cons__list">
                {product.cons.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}

      {/* Who it's for */}
      {product.whoFor && (
        <div class="who-for">
          <h3>Who It&rsquo;s For</h3>
          <p>{product.whoFor}</p>
        </div>
      )}
      {product.whoNotFor && (
        <div class="who-for">
          <h3>Who It&rsquo;s Not For</h3>
          <p>{product.whoNotFor}</p>
        </div>
      )}

{/* Editorial Review */}
      {body && (() => {
        if (/<[a-z][\s\S]*>/i.test(body)) {
          return (
            <section class="editorial-review">
              <h2 class="review-heading">Our Review</h2>
              <div class="review-byline">By the GearCompared editorial team &middot; {product.brand && `${product.brand} `}{product.lastUpdated ? new Date(product.lastUpdated).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) : ''}</div>
              <div class="guide-section" set:html={body} />
            </section>
          );
        }
        const htmlBody = body.split(/\n\n+/).map(p => `<p>${p.trim()}</p>`).join('');
        return (
          <section class="editorial-review">
            <h2 class="review-heading">Our Review</h2>
            <div class="review-byline">By the GearCompared editorial team &middot; {product.brand && `${product.brand} `}{product.lastUpdated ? new Date(product.lastUpdated).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) : ''}</div>
            <div class="guide-section" set:html={htmlBody} />
          </section>
        );
      })()}

      {relatedProducts && relatedProducts.length > 0 && (
        <section class="related">
          <h2>Compare with similar products</h2>
          <div class="related-list">
            {relatedProducts.map((p) => (
              <a href={p.affiliateUrl} rel="nofollow sponsored" target="_blank">
                {p.title} ({p.rating} &starf;) &rarr;
              </a>
            ))}
          </div>
        </section>
      )}
      {relatedGuides && relatedGuides.length > 0 && (
        <section class="related">
          <h2>Further reading</h2>
          <div class="related-list">
            {relatedGuides.map((g) => (
              <a href={`/${g.slug}/`}>
                {g.title} &rarr;
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
