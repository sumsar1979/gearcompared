---
// ProductLayout — Single product review page
import BaseLayout from './BaseLayout.astro';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  body,
  relatedProducts = [],
} = Astro.props;

const product = products[0] || {};
---

<BaseLayout title={title} description={description}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <header class="article-header">
        <h1>{product.title || title}</h1>
        <div style="font-size:1rem;color:var(--text-tertiary);margin-bottom:12px;">{product.brand}</div>
        <p class="article-desc">{description}</p>
      </header>

      <p class="disclosure-inline">
        When you buy through our links, we may earn a commission.
        <a href="/disclosure/">Here&rsquo;s how we choose</a>.
      </p>

      <div class="product-card">
        <div class="product-card__price">
          ${product.price || '?'}
          {product.listPrice && <span class="list-price">${product.listPrice}</span>}
        </div>
        <div class="product-card__specs">
          {product.rating && <span>{product.rating} &starf; &middot; {(product.reviewCount || 0).toLocaleString()} reviews</span>}
        </div>
        {product.specs && typeof product.specs === 'object' && (
          <table class="specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr><td class="row-label">{key}</td><td>{value}</td></tr>
              ))}
            </tbody>
          </table>
        )}
        <a href={product.affiliateUrl} class="product-card__cta" rel="nofollow sponsored" target="_blank">
          Check Price on Amazon &rarr;
        </a>
        <div style="font-size:0.8rem;color:var(--text-tertiary);margin-top:8px;">
          As an Amazon Associate we earn from qualifying purchases.
        </div>
      </div>

      {body && <section class="guide-section" set:html={body} />}

      {relatedProducts && relatedProducts.length > 0 && (
        <section class="related">
          <h2>Compare with similar products</h2>
          <div class="related-list">
            {relatedProducts.map((p) => (
              <a href={p.affiliateUrl} rel="nofollow sponsored" target="_blank">
                {p.title} ({p.rating} &starf;) &rarr;
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
