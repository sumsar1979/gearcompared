---
// ProductLayout — Single product detail page
import BaseLayout from './BaseLayout.astro';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  relatedProducts = [],
} = Astro.props;

const product = products[0] || {};
---

<BaseLayout title={title} description={description}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <header class="article-header">
        <h1>{product.name}</h1>
        <div style="font-size:1rem;color:var(--text-tertiary);margin-bottom:12px;">{product.brand}</div>
        <p style="font-size:1.05rem;color:var(--text-secondary);">{description}</p>
      </header>

      <p class="disclosure-inline">
        When you buy through our links, we may earn a commission.
        <a href="/disclosure/">Here's how we choose</a>.
      </p>

      <div class="product-card">
        <div class="product-card__price">${product.price || '?'}</div>
        <div class="product-card__specs">
          {product.rating && <span>{product.rating} ★ · {(product.reviewCount || 0).toLocaleString()} reviews</span>}
        </div>
        {product.specs && typeof product.specs === 'object' && (
          <table class="specs-table">
            <tbody>
              {Object.entries(product.specs).map(([key, value]) => (
                <tr><td class="row-label">{key}</td><td>{value}</td></tr>
              ))}
            </tbody>
          </table>
        )}
        {product.body && <p class="product-card__body">{product.body}</p>}
        <a href={product.link || `/go/${product.asin}/`} class="product-card__cta">
          View on Amazon &rarr;
        </a>
      </div>

      {relatedProducts && relatedProducts.length > 0 && (
        <section class="related">
          <h2>Compare with similar products</h2>
          <div class="related-list">
            {relatedProducts.map((p) => (
              <a href={`/${category}/compare/${product.asin}-vs-${p.asin}/`}>
                {product.name} vs {p.name} &rarr;
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
