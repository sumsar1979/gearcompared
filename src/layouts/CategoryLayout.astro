---
// CategoryLayout — Category hub page
import BaseLayout from './BaseLayout.astro';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  subcategoryLinks = [],
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <header class="article-header">
      <h1>{title}</h1>
      {description && <p style="font-size:1.05rem;color:var(--text-secondary);line-height:1.6;margin-bottom:24px;">{description}</p>}
    </header>

    {subcategoryLinks.length > 0 && (
      <section style="margin-bottom:40px;">
        <h2 style="font-family:var(--font-ui);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-tertiary);margin-bottom:16px;">Browse by category</h2>
        <div class="related-list">
          {subcategoryLinks.map((link) => (
            <a href={`/${link.slug}/`}>
              {link.name} &rarr;
            </a>
          ))}
        </div>
      </section>
    )}

    {products.length > 0 && (
      <section>
        <h2 style="margin-bottom:16px;">Top {products.length} products</h2>
        {products.slice(0, 5).map((product) => (
          <div class="product-card">
            <div class="product-card__title">{product.title || product.name}</div>
            <div class="product-card__brand">{product.brand}</div>
            <div class="product-card__price">${product.price || '?'}</div>
            <div class="product-card__specs">
              {product.rating && <span>{product.rating} ★ · {(product.reviewCount || 0).toLocaleString()} reviews</span>}
            </div>
            <a href={product.affiliateUrl || `/${category}/product/${product.asin}/`} class="product-card__cta" rel="nofollow sponsored" target="_blank">
              View on Amazon &rarr;
            </a>
          </div>
        ))}
      </section>
    )}

    <div style="margin-top:40px;">
      {subcategoryLinks.length > 0 && (
        <a href={`/${subcategoryLinks[0].slug}/`} style="font-family:var(--font-ui);font-size:0.9rem;">
          Browse {subcategoryLinks[0].name} &rarr;
        </a>
      )}
      {subcategoryLinks.length === 0 && products.length > 0 && (
        <a href={`/${category}/best-${category}/`} style="font-family:var(--font-ui);font-size:0.9rem;">
          See our full roundup &rarr;
        </a>
      )}
    </div>
  </main>
</BaseLayout>
