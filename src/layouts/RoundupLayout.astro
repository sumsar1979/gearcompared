---
// RoundupLayout — "Best X" editorial roundup pages
import BaseLayout from './BaseLayout.astro';
import StickyTOC from '../components/StickyTOC.astro';
import { generateItemListLD, generateBreadcrumbLD, generateFAQLD, mergeLD } from '../lib/structured-data';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  intro,
  howWeChose,
  faqs = [],
  winner,
  winnerLabel,
  winnerReason,
  pageUrl,
  relatedGuides = [],
} = Astro.props;

// Schema
const breadcrumbLD = breadcrumbs.length ? generateBreadcrumbLD(breadcrumbs) : null;
const itemListLD = generateItemListLD(products, title, pageUrl);
const faqLD = faqs.length ? generateFAQLD(faqs) : null;
const schemaComponents = [breadcrumbLD, itemListLD, faqLD].filter(Boolean);
const schema = schemaComponents.length === 1 ? schemaComponents[0] : mergeLD(...schemaComponents);

// TOC headings
const tocHeadings = [
  { id: 'contenders', text: 'The Contenders', level: 'h2' },
];
if (howWeChose) tocHeadings.push({ id: 'how-we-chose', text: 'How We Chose', level: 'h2' });
if (faqs.length) tocHeadings.push({ id: 'faq', text: 'Common Questions', level: 'h2' });
---

<BaseLayout title={title} description={description} schema={schema}>
  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <StickyTOC headings={tocHeadings} />
      <header class="article-header">
        <div class="changelog">Updated {new Date().toISOString().split('T')[0]} &middot; {products.length} products compared</div>
        <h1>{title}</h1>
        {description && <p class="article-desc">{description}</p>}
      </header>

      <p class="disclosure-inline">
        We earn commissions from purchases made through links in this post at no extra cost to you.
        <a href="/disclosure/">Here&rsquo;s how we choose</a> &mdash; commissions don&rsquo;t influence our picks.
      </p>

      {intro && <section class="intro"><p>{intro}</p></section>}

      {winner && winnerLabel && (
        <div class="winner-box" id="winner">
          <div class="winner-box__badge">{winnerLabel}</div>
          <div class="winner-box__product">
            {products.find(p => p.asin === winner)?.title || winner}
          </div>
          {winnerReason && <div class="winner-box__reason">{winnerReason}</div>}
          {(() => {
            const wp = products.find(p => p.asin === winner);
            if (!wp) return null;
            return (
              <a href={wp.affiliateUrl} class="btn btn-buy winner-box__cta" rel="nofollow sponsored" target="_blank">
                Check Price on Amazon &rarr;
              </a>
            );
          })()}
        </div>
      )}

      <section id="contenders">
        <h2>The contenders</h2>
        {products.map((product) => (
          <div class="product-card">
            {product.imageUrl && (
              <a href={product.affiliateUrl} rel="nofollow sponsored" target="_blank" class="product-card__image-link">
                <img src={product.imageUrl} alt={product.title} class="product-card__image" loading="lazy" width="300" height="300" />
              </a>
            )}
            <div class="product-card__header">
              <div>
                <div class="product-card__title">
                  <a href={product.affiliateUrl} rel="nofollow sponsored" target="_blank">{product.title}</a>
                </div>
                <div class="product-card__brand">{product.brand}</div>
              </div>
              {product.asin === winner && winnerLabel && <span class="product-card__label">{winnerLabel}</span>}
            </div>
            <div class="product-card__price">
              {product.price ? `$${product.price}` : 'Price not available'}
              {product.listPrice && <span class="list-price">$${product.listPrice}</span>}
            </div>
            {product.specs && typeof product.specs === 'object' && (
              <div class="product-card__specs">
                {Object.entries(product.specs).map(([key, value]) => (
                  <span>{value} <span class="sep">&middot;</span></span>
                ))}
              </div>
            )}
            {product.features && product.features.length > 0 && (
              <ul class="feature-list">
                {product.features.map((f) => <li>{f}</li>)}
              </ul>
            )}
            {product.rating && (
              <div class="product-card__rating">
                <span class="product-card__stars">{product.rating} &starf;</span>
                <span class="product-card__review-count">{(product.reviewCount || 0).toLocaleString()}+ ratings</span>
                <a href={(() => { if (product.affiliateUrl && product.affiliateUrl.includes('/dp/')) return `https://www.amazon.com/dp/${product.asin}#customerReviews?tag=gearcompared2-20`; return `https://www.amazon.com/s?k=${encodeURIComponent(product.title)}#customerReviews&tag=gearcompared2-20`; })()} class="product-card__review-link" rel="nofollow sponsored" target="_blank">
                  See reviews on Amazon &rarr;
                </a>
              </div>
            )}
            <a href={product.affiliateUrl} class="product-card__cta" rel="nofollow sponsored" target="_blank">
              Check Price on Amazon &rarr;
            </a>
            <div style="font-size:0.8rem;color:var(--text-tertiary);margin-top:4px;">As an Amazon Associate we earn from qualifying purchases.</div>
          </div>
        ))}
      </section>

      {howWeChose && <section id="how-we-chose" class="guide-section" set:html={howWeChose} />}

      {faqs.length > 0 && (
        <section id="faq" class="faq">
          <h2>Common questions</h2>
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      )}
      {relatedGuides.length > 0 && (
        <section class="related">
          <h2>Further reading</h2>
          <div class="related-list">
            {relatedGuides.map((g) => (
              <a href={`/${g.slug}/`}>
                {g.title} &rarr;
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
