---
// RoundupLayout — "Best X for Y" comparison roundup pages
import BaseLayout from './BaseLayout.astro';
import StructuredData from '../lib/structured-data';

const {
  title,
  description,
  category,
  products = [],
  breadcrumbs = [],
  guideSections = [],
  faq = [],
  relatedPages = [],
} = Astro.props;

const url = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <StructuredData
    type="itemList"
    data={{
      items: products.map((p, i) => ({
        position: i + 1,
        name: p.name,
        brand: p.brand,
        url: p.link,
        image: p.imageUrl,
        price: p.price,
        rating: p.rating,
        reviewCount: p.reviewCount,
      })),
    }}
  />

  <main class="content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <span>
          {i > 0 && <span class="sep"> / </span>}
          {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : crumb.name}
        </span>
      ))}
    </nav>

    <article>
      <header class="article-header">
        <div class="changelog">Updated {new Date().toISOString().split('T')[0]} · {products.length} products compared</div>
        <h1>{title}</h1>
        {description && <p style="font-size:1.05rem;color:var(--text-secondary);line-height:1.6;margin-bottom:24px;">{description}</p>}
      </header>

      <p class="disclosure-inline">
        When you buy through our links, we may earn a commission.
        <a href="/disclosure/">Here's how we choose</a> &mdash; commissions don't influence our picks.
      </p>

      {products.map((product) => (
        <div class="product-card">
          <div class="product-card__header">
            <div>
              <div class="product-card__title">{product.name}</div>
              <div class="product-card__brand">{product.brand}</div>
            </div>
            {product.label && <span class="product-card__label">{product.label}</span>}
          </div>
          <div class="product-card__price">
            {product.price ? `$${product.price}` : 'Price not available'}
          </div>
          <div class="product-card__specs">
            {product.specs && typeof product.specs === 'object' && Object.entries(product.specs).map(([key, value]) => (
              <span>{value} <span class="sep">·</span></span>
            ))}
            <span>{product.rating} ★ from {product.reviewCount?.toLocaleString()}+ reviews</span>
          </div>
          {product.body && <p class="product-card__body">{product.body}</p>}
          <a href={product.link || `/go/${product.asin}/`} class="product-card__cta">
            View on Amazon &rarr;
          </a>
        </div>
      ))}

      {guideSections.length > 0 && (
        <section class="guide-section">
          <h2>What actually matters when buying a {category?.toLowerCase() || 'product'}</h2>
          {guideSections.map((section) => (
            <div>
              <h3>{section.title}</h3>
              <p>{section.body}</p>
            </div>
          ))}
        </section>
      )}

      {faq.length > 0 && (
        <section class="faq">
          <h2>Common questions</h2>
          {faq.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      )}

      {relatedPages.length > 0 && (
        <section class="related">
          <h2>More comparisons</h2>
          <div class="related-list">
            {relatedPages.map((p) => (
              <a href={p.url}>{p.title} &rarr;</a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
