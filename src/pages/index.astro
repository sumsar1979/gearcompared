---
import RoundupLayout from '../layouts/RoundupLayout.astro';
import desksData from '../../data/manifests/standing-desks.json';

const roundup = desksData.find((m) => m.type === 'roundup');
const { title, description, intro, howWeChose, faqs, winner, winnerLabel, winnerReason, products } = roundup;

// Top 5 by rating × reviewCount
const topProducts = [...products]
  .sort((a, b) => (b.rating * b.reviewCount) - (a.rating * a.reviewCount))
  .slice(0, 5);
---

<RoundupLayout
  title={title}
  description={description}
  category="standing-desks"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Standing Desks' }]}
  products={topProducts}
  intro={intro}
  howWeChose={howWeChose}
  faqs={faqs}
  winner={winner}
  winnerLabel={winnerLabel}
  winnerReason={winnerReason}
/>
