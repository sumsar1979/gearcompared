---
// StickyTOC — desktop sticky table of contents
// Props: headings: {id: string, text: string}[]
const { headings = [] } = Astro.props;
if (!headings.length) return null;
---

<nav class="toc" aria-label="Table of contents">
  <div class="toc__title">On this page</div>
  <ul class="toc__list">
    {headings.map((h) => (
      <li class={`toc__item toc__item--${h.level || 'h2'}`}>
        <a href={`#${h.id}`}>{h.text}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc {
    position: sticky;
    top: 72px;
    float: right;
    width: 200px;
    margin-left: 32px;
    margin-bottom: 24px;
    padding: 16px 0;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    z-index: 10;
  }

  .toc__title {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin-bottom: 12px;
    font-size: 0.7rem;
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc__item {
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .toc__item--h3 {
    padding-left: 12px;
  }

  .toc__item a {
    color: var(--text-secondary);
    border-bottom: none;
    transition: color var(--transition-fast);
  }

  .toc__item a:hover {
    color: var(--link);
    border-bottom: 1px dotted var(--link);
  }

  @media (max-width: 900px) {
    .toc {
      display: none;
    }
  }
</style>
